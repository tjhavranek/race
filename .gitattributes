# Byte-identity contract: never normalize the three deployed files.
# (index.html is "text" but its bytes are part of the published artifact;
#  treating it as binary prevents Windows autocrlf from rewriting LF -> CRLF
#  in working trees and matching the deployed file's hash everywhere.)
index.html               -text
favicon.png              binary
litomysl-racing-game.apk binary

# Standard text files
*.md   text
*.yml  text
*.yaml text
*.json text
*.py   text
*.bat  text eol=crlf
*.sh   text eol=lf

# Linguist / language stats:
# The deployed game is a 140 KB Pygbag Python+WebAssembly bundle, not HTML.
# Hide the wrapper HTML from the language bar; mark the apk bundle as vendored
# so Linguist doesn't pick a language for it either.
index.html               linguist-detectable=false
*.apk                    linguist-vendored
